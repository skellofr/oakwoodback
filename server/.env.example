# --- Serveur ---
PORT=8080
NODE_ENV=development
# URL publique du serveur (liens du manifest + redirection OAuth)
PUBLIC_BASE_URL=http://localhost:8080

# --- Upload legacy (admin-tool desktop) ---
UPLOAD_TOKEN=change-me-to-a-long-random-secret

# --- Login admin via Discord ---
# Crée une app sur https://discord.com/developers/applications
# Redirection OAuth2 à ajouter : {PUBLIC_BASE_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
# IDs Discord autorisés (séparés par virgules). Vide = le 1er à se connecter devient admin.
ADMIN_DISCORD_IDS=
